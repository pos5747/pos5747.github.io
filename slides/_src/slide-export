#!/bin/zsh
# slide-export — export a Keynote deck to PDF without point-and-click.
#
#   slide-export wk01-slides.key wk01-slides.pdf
#
# WHY IT WORKS ON A COPY. The hard rule is that nothing writes to a .key.
# Opening a deck in Keynote is itself a write risk: Keynote 15 upgrades the
# internal format of a deck last saved by Keynote 14 and autosaves it. So this
# copies the deck to a scratch directory, opens and exports THE COPY, and
# deletes it. The original is never opened, never upgraded, never touched.
#
# CONSEQUENCE: the PDF reflects the deck AS LAST SAVED. If Carlisle is editing
# and has not saved, export shows the saved state, not the screen.
#
# Targets bundle id com.apple.Keynote (Apple's current Keynote; see
# keynote-scripting-notes.md, "Which Keynote to target").

set -e

KEY="${1:A}"
OUT="${2:A}"
[[ -z "$KEY" || -z "$OUT" ]] && { echo "usage: slide-export <deck.key> <out.pdf>"; exit 1 }
[[ -f "$KEY" ]] || { echo "slide-export: no such deck: $KEY"; exit 1 }

BUNDLE="com.apple.Keynote"
# Home-directory scratch: /private/tmp is one of the sandboxed paths where
# LaunchServices open silently fails (see the notes).
WORK="${HOME}/.slide-export-tmp.$$"
COPY="${WORK}/$(basename "$KEY")"

cleanup() {
  osascript -e "tell application id \"$BUNDLE\"
    repeat with d in (get documents)
      if (POSIX path of (file of d as alias)) is equal to \"$COPY\" then close d saving no
    end repeat
  end tell" >/dev/null 2>&1 || true
  rm -rf "$WORK"
}
trap cleanup EXIT

mkdir -p "$WORK"
cp -R "$KEY" "$COPY"

open -b "$BUNDLE" "$COPY"

# Wait for the copy to appear as an open document, matched by path, never by
# "front document" (see the notes, "The wrong-document trap").
found=0
for i in {1..60}; do
  n=$(osascript -e "tell application id \"$BUNDLE\"
    set c to 0
    repeat with d in (get documents)
      try
        if (POSIX path of (file of d as alias)) is equal to \"$COPY\" then set c to c + 1
      end try
    end repeat
    return c
  end tell" 2>/dev/null) || n=0
  [[ "$n" == "1" ]] && { found=1; break }
  sleep 1
done
[[ $found -eq 1 ]] || { echo "slide-export: deck never opened in Keynote ($BUNDLE)"; exit 1 }

mkdir -p "$(dirname "$OUT")"
rm -f "$OUT"

osascript -e "tell application id \"$BUNDLE\"
  repeat with d in (get documents)
    try
      if (POSIX path of (file of d as alias)) is equal to \"$COPY\" then
        export d to POSIX file \"$OUT\" as PDF with properties {PDF image quality:Best}
      end if
    end try
  end repeat
end tell" >/dev/null

[[ -f "$OUT" ]] || { echo "slide-export: export produced no file"; exit 1 }
echo "✓ $(basename "$OUT")  ($(pdfinfo "$OUT" 2>/dev/null | awk '/^Pages/{print $2}') pages)"
