#!/bin/zsh
# key-sync — push regenerated asset files into a Keynote deck, in place.
#
# For every image OR movie (animated GIF) in the deck whose ORIGINAL file
# name matches the basename of an asset you pass, the object is replaced
# with the new file at the same position, width, rotation, and opacity.
# The deck is saved afterward.
#
# Usage:
#   key-sync deck.key equations/eqn-mle.pdf figs/consistency.gif ...
#
# Notes / limitations (verified against Keynote 15):
#   - Matching is by file name: give every asset a unique, stable name, and
#     DRAG assets in the first time (pasting names them "pasted-image").
#   - The replacement lands on top of the z-order with default styling —
#     don't sync images that carry Keynote shadows/borders/builds or that
#     sit underneath annotations.
#   - Animated GIFs are movie objects; they're replaced via image-insert,
#     which Keynote auto-promotes back to a movie.

set -e
deck="${1:A}"
shift
[[ -z "$deck" || $# -eq 0 ]] && { echo "usage: key-sync <deck.key> <asset> [asset ...]"; exit 1 }

args=("$deck")
for f in "$@"; do
  [[ -f "$f" ]] || { echo "no such file: $f"; exit 1 }
  args+=("${f:t}" "${f:A}")
done

osascript - "${args[@]}" <<'EOF'
on replaceItem(s, obj, newPath)
	tell application "Keynote"
		set p to position of obj
		set w to width of obj
		set r to rotation of obj
		set o to opacity of obj
		set wasLocked to locked of obj
		if wasLocked then set locked of obj to false
		delete obj
		tell s
			set newObj to make new image with properties {file:POSIX file newPath}
		end tell
		set position of newObj to p
		set width of newObj to w
		if r is not 0 then set rotation of newObj to r
		if o is not 100 then set opacity of newObj to o
		if wasLocked then set locked of newObj to true
	end tell
end replaceItem

on openDeck(deckPath)
	tell application "Keynote"
		set doc to open (POSIX file deckPath)
		if doc is missing value then
			repeat 100 times
				repeat with d in documents
					try
						if POSIX path of (file of d) is deckPath then
							set doc to contents of d
							exit repeat
						end if
					end try
				end repeat
				if doc is not missing value then exit repeat
				delay 0.1
			end repeat
		end if
		if doc is missing value then error "could not open " & deckPath
	end tell
	return doc
end openDeck

on run argv
	set deckPath to item 1 of argv
	set pairs to rest of argv
	set replaced to {}
	set wanted to {}
	repeat with k from 1 to (count of pairs) by 2
		set end of wanted to item k of pairs
	end repeat
	set doc to my openDeck(deckPath)
	tell application "Keynote"
		repeat with i from 1 to count of slides of doc
			set s to slide i of doc
			repeat with kind in {"image", "movie"}
				set j to 1
				repeat
					try
						if (kind as text) is "image" then
							set obj to image j of s
						else
							set obj to movie j of s
						end if
					on error
						exit repeat
					end try
					set objName to file name of obj
					set newPath to ""
					repeat with k from 1 to (count of pairs) by 2
						if item k of pairs is objName then
							set newPath to item (k + 1) of pairs
							exit repeat
						end if
					end repeat
					if newPath is not "" then
						my replaceItem(s, obj, newPath)
						set end of replaced to (objName & " (slide " & i & ")")
					else
						set j to j + 1
					end if
				end repeat
			end repeat
		end repeat
		save doc
	end tell
	set AppleScript's text item delimiters to ", "
	set unmatched to {}
	repeat with w in wanted
		if replaced as text does not contain (w as text) then set end of unmatched to (w as text)
	end repeat
	set msg to "replaced " & (count of replaced) & ": " & (replaced as text)
	if (count of unmatched) > 0 then set msg to msg & linefeed & "no match in deck for: " & (unmatched as text)
	return msg
end run
EOF
