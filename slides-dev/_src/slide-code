"""
slide-code — put syntax-highlighted R code on the clipboard, styled and ready
to paste straight into Keynote (no browser, no select-and-copy, no restyling:
the RTF arrives as Menlo 24, the deck's code font).

Colors follow the course convention (ColorBrewer Set1):
comments red, keywords/functions blue, strings/constants green, rest black.

Usage:
  slide-code script.R              whole file -> clipboard (RTF)
  slide-code script.R fit-model    the snippet named by a fence (see below)
  slide-code script.R 10:24        lines 10-24 (prefer fences; ranges go stale)
  slide-code script.R --list       list the fence names in the script
  cat snippet.R | slide-code -     from stdin

  slide-code script.R fit-model --pdf code/code-fit-model.pdf
                                   render the snippet to a cropped vector PDF
                                   (a draggable image asset, like an equation)

Fences: mark each slide excerpt in the master script with

  ## ---- slide: fit-model ----

The snippet runs to the next `## ----` fence or end of file. Declare the same
name in the week's snippets.mk so `make audit` checks it.
"""

import os
import subprocess
import sys
import tempfile

sys.dont_write_bytecode = True  # no __pycache__ in _src/
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from slidelib import extract, snippet_names

from pygments import highlight
from pygments.formatters import RtfFormatter
from pygments.lexers import get_lexer_by_name
from pygments.style import Style
from pygments.token import Comment, Keyword, Literal, Name, Number, Operator, String, Text

# Deck code style: Menlo 24 pt (fontsize is in half-points).
FONT = "Menlo"
FONTSIZE_HALFPT = 48


class Set1Style(Style):
    background_color = "#ffffff"
    styles = {
        Text: "#1a1a1a",
        Operator: "#1a1a1a",
        Name: "#1a1a1a",
        Comment: "#e41a1c",
        Keyword: "#377eb8",
        Name.Function: "#377eb8",
        Name.Builtin: "#377eb8",
        String: "#4daf4a",
        Literal: "#4daf4a",
        Number: "#1a1a1a",          # numbers stay black (deck convention)
        Keyword.Constant: "#4daf4a",  # TRUE / FALSE / NULL green
    }


def to_pdf(code: str, out_pdf: str) -> None:
    from pygments.formatters import LatexFormatter

    fmt = LatexFormatter(style=Set1Style)
    body = highlight(code.rstrip() + "\n", get_lexer_by_name("r"), fmt)
    tex = "\n".join(
        [
            r"\documentclass[border=3bp,varwidth]{standalone}",
            r"\usepackage[T1]{fontenc}",
            r"\usepackage{sourcecodepro}",   # closest LaTeX match to Menlo
            r"\usepackage{fancyvrb,xcolor}",
            fmt.get_style_defs(),
            r"\begin{document}",
            body,
            r"\end{document}",
        ]
    )
    out_pdf = os.path.abspath(out_pdf)
    with tempfile.TemporaryDirectory() as tmp:
        texfile = os.path.join(tmp, "snippet.tex")
        with open(texfile, "w") as f:
            f.write(tex)
        subprocess.run(
            ["latexmk", "-pdf", "-interaction=nonstopmode", "snippet.tex"],
            cwd=tmp,
            check=True,
            capture_output=True,
        )
        os.replace(os.path.join(tmp, "snippet.pdf"), out_pdf)
    print(f"✓ wrote {out_pdf}")


def main() -> None:
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        print(__doc__)
        sys.exit(0)

    out_pdf = None
    if "--pdf" in args:
        i = args.index("--pdf")
        out_pdf = args[i + 1]
        args = args[:i] + args[i + 2 :]

    list_only = "--list" in args
    if list_only:
        args.remove("--list")

    path = args[0]
    if path == "-":
        code = sys.stdin.read()
    else:
        with open(path) as f:
            code = f.read()

    if list_only:
        names = snippet_names(code)
        print("\n".join(names) if names else "(no fences)")
        return

    # legacy two-number form (10 24) still accepted alongside 10:24
    if len(args) == 3 and args[1].isdigit() and args[2].isdigit():
        spec = f"{args[1]}:{args[2]}"
    elif len(args) == 2:
        spec = args[1]
    else:
        spec = None

    try:
        code, label = extract(code, spec)
    except ValueError as e:
        sys.exit(f"slide-code: {e}")

    if out_pdf is not None:
        to_pdf(code, out_pdf)
        return

    rtf = highlight(
        code.rstrip() + "\n",
        get_lexer_by_name("r"),
        RtfFormatter(style=Set1Style, fontface=FONT, fontsize=FONTSIZE_HALFPT),
    )

    subprocess.run(["pbcopy", "-Prefer", "rtf"], input=rtf.encode(), check=True)
    n = code.rstrip().count("\n") + 1
    print(f"✓ {n} line(s) [{label}] on the clipboard as {FONT} 24 — paste into Keynote.")


if __name__ == "__main__":
    main()
