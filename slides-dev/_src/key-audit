"""
key-audit — check whether a Keynote deck's embedded assets and code snippets
are up to date with their sources. Read-only: the deck is never modified.

Usage:
  key-audit deck.key asset.pdf [asset2.gif ...]              media only
  key-audit deck.key *.pdf --code master.R fit-model [...]   media + code text

Media check (no Keynote needed): a .key is a zip whose Data/ entries keep
their original file names. Each asset you pass is matched by name stem and
compared content-wise — PDFs are rasterized (pdftoppm) so metadata-only
differences don't count as stale; other files compare byte-for-byte.

Code check (--code FILE SPEC, repeatable): opens the deck in Keynote
(read-only) once, extracts all slide text, and verifies each declared
snippet appears in the deck, whitespace- and smart-quote-normalized.
SPEC is a fence name (`## ---- slide: fit-model ----` in the script),
`all` for the whole file, or a `first:last` line range.

Verdicts: CURRENT · STALE · NOT IN DECK.  Exit code 1 if anything is off.
"""

import os
import re
import subprocess
import sys
import tempfile
import zipfile

sys.dont_write_bytecode = True  # no __pycache__ in _src/
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from slidelib import extract

MEDIA_RE_TEMPLATE = r"^Data/%s(-\d+)?\.%s$"


def rasterize(pdf_path, out_prefix):
    subprocess.run(
        ["pdftoppm", "-r", "100", pdf_path, out_prefix],
        check=True,
        capture_output=True,
    )
    pages = sorted(
        f for f in os.listdir(os.path.dirname(out_prefix) or ".")
        if os.path.basename(f).startswith(os.path.basename(out_prefix))
    )
    return [os.path.join(os.path.dirname(out_prefix), f) for f in pages]


def pdfs_visually_equal(a, b, tmp):
    ra = rasterize(a, os.path.join(tmp, "a"))
    rb = rasterize(b, os.path.join(tmp, "b"))
    if len(ra) != len(rb):
        return False
    for fa, fb in zip(ra, rb):
        with open(fa, "rb") as f1, open(fb, "rb") as f2:
            if f1.read() != f2.read():
                return False
    return True


def normalize(text):
    text = re.sub(r"[‘’‛]", "'", text)
    text = re.sub(r"[“”]", '"', text)
    text = text.replace("−", "-").replace("…", "...")
    return re.sub(r"\s+", " ", text).strip()


def deck_text(deck):
    # Two Keynote traps (see keynote-scripting-notes.md):
    #   1. Target application id "com.apple.iWork.Keynote" — a third-party
    #      App Store app ("Keynote Creator Studio") spoofs com.apple.Keynote
    #      and intercepts `tell application "Keynote"`.
    #   2. Open the deck via LaunchServices (`open -b`), not an Apple-event
    #      `open`: sandboxed Keynote silently refuses Apple-event opens of
    #      some paths (e.g. ~/Library/CloudStorage/Dropbox). LaunchServices
    #      grants access like a Finder double-click.
    # Everything happens in ONE osascript session: separate osascript calls
    # give a window-less Keynote time to auto-terminate in between
    # ("Connection is invalid"). The open itself goes through LaunchServices
    # (`do shell script "open -b ..."`) inside the session.
    script = """
on run argv
	set deckPath to item 1 of argv
	set deckName to item 2 of argv
	with timeout of 600 seconds
	tell application id "com.apple.iWork.Keynote"
		set wasOpen to (count of (documents whose name is deckName)) > 0
		if not wasOpen then
			do shell script "open -b com.apple.iWork.Keynote " & quoted form of deckPath
		end if
		set doc to missing value
		repeat 300 times
			repeat with d in documents
				if (name of d) is deckName then
					set doc to contents of d
					exit repeat
				end if
			end repeat
			if doc is not missing value then exit repeat
			delay 0.2
		end repeat
		if doc is missing value then error "could not open " & deckName
		set chunks to {}
		repeat with i from 1 to count of slides of doc
			set s to slide i of doc
			repeat with j from 1 to count of text items of s
				try
					set end of chunks to (object text of text item j of s) as text
				end try
			end repeat
		end repeat
		if not wasOpen then close doc saving no
		set AppleScript's text item delimiters to linefeed & "@@@" & linefeed
		return chunks as text
	end tell
	end timeout
end run
"""
    r = subprocess.run(
        ["osascript", "-", deck, os.path.basename(deck)],
        input=script.encode(),
        capture_output=True,
    )
    if r.returncode != 0:
        sys.exit(f"key-audit: text extraction failed: {r.stderr.decode().strip()}")
    return r.stdout.decode()


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        print(__doc__)
        sys.exit(0)

    snippets = []
    while "--code" in args:
        i = args.index("--code")
        # legacy 3-arg form (--code file 10 24) still accepted
        if i + 3 < len(args) and args[i + 2].isdigit() and args[i + 3].isdigit():
            snippets.append((args[i + 1], f"{args[i + 2]}:{args[i + 3]}"))
            args = args[:i] + args[i + 4 :]
        else:
            snippets.append((args[i + 1], args[i + 2]))
            args = args[:i] + args[i + 3 :]

    deck, assets = os.path.abspath(args[0]), args[1:]
    problems = 0

    with zipfile.ZipFile(deck) as zf:
        names = zf.namelist()
        with tempfile.TemporaryDirectory() as tmp:
            for asset in assets:
                base = os.path.basename(asset)
                stem, ext = os.path.splitext(base)
                # The eqn-NN- sequence number is NOT part of the deck<->source
                # link: match embedded copies under any (or no) number with
                # the same slug, so renumbering sources never breaks the
                # audit. (The trailing (-\d+)? is Keynote's own insert
                # suffix.)
                nm = re.match(r"^eqn-\d+-(.+)$", stem)
                stem_re = (
                    r"eqn(?:-\d+)?-" + re.escape(nm.group(1)) if nm else re.escape(stem)
                )
                pattern = re.compile(
                    MEDIA_RE_TEMPLATE % (stem_re, re.escape(ext.lstrip(".")))
                )
                matches = [n for n in names if pattern.match(n)]
                if not matches:
                    print(f"  ✗ NOT IN DECK   {base}")
                    problems += 1
                    continue
                with open(asset, "rb") as f:
                    src = f.read()
                for m in matches:
                    embedded = zf.read(m)
                    if embedded == src:
                        ok = True
                    elif ext == ".pdf":
                        ea = os.path.join(tmp, "emb.pdf")
                        with open(ea, "wb") as f:
                            f.write(embedded)
                        sub = os.path.join(tmp, "cmp")
                        os.makedirs(sub, exist_ok=True)
                        ok = pdfs_visually_equal(ea, asset, sub)
                        for f_ in os.listdir(sub):
                            os.remove(os.path.join(sub, f_))
                    else:
                        ok = False
                    tag = "✓ CURRENT     " if ok else "✗ STALE       "
                    if not ok:
                        problems += 1
                    print(f"  {tag}{base}  [{m}]")

    if snippets:
        haystack = normalize(deck_text(deck))
        for path, spec in snippets:
            with open(path) as f:
                source = f.read()
            try:
                code, label = extract(source, spec)
            except ValueError as e:
                print(f"  ✗ BAD SNIPPET  {os.path.basename(path)}: {e}")
                problems += 1
                continue
            label = f"{os.path.basename(path)} [{label}]"
            if normalize(code) in haystack:
                print(f"  ✓ CURRENT     code {label}")
            else:
                print(f"  ✗ STALE/ABSENT code {label}")
                problems += 1

    print(f"\n{'all up to date ✓' if problems == 0 else f'{problems} problem(s)'}")
    sys.exit(1 if problems else 0)


if __name__ == "__main__":
    main()
